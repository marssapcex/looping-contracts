tails": "Mint an amount of the token and assigns it to an account. This encapsulates the modification of balances such that the proper events are emitted.", "params": {"_to": "The account that will receive the created tokens.", "_value": "The amount that will be created."}}, "burnFrom(address,uint256)": {"details": "Burn an amount of the token from a given account.", "params": {"_to": "The account whose tokens will be burned.", "_value": "The amount that will be burned."}}}}}, "version": "0.2.11"}
